# GEMINI_API_KEY: Required for server-side Gemini AI chatbot responses.
# AI Studio injects this automatically from Secrets; leave placeholder here.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional Gemini model override (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Hosted URL injected automatically by AI Studio.
APP_URL="MY_APP_URL"

# PORT: Server port (must be 3000 in AI Studio preview).
PORT="3000"

# DATABASE_URL: Optional PostgreSQL connection string if extending with an external DB.
DATABASE_URL="postgresql://user:password@localhost:5432/paimana_ai"
